{
  "manifest_version": 3,
  "name": "Layout Shower",
  "version": "1.1.1",
  "description": "Affiche margins, borders, paddings, flex (direction), grid (pistes) et gaps de la page avec leurs tailles, comme le panneau Mise en page des DevTools.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Layout Shower",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Activer / désactiver l'affichage du layout"
    },
    "cycle-mode": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Basculer entre le mode Survol et Tout afficher"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "layout-shower@baptiste-lore.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
